# Payments happen only in the app (App Store / Google Play); the site has no checkout.

# Where founder-list sign-ups are forwarded (an email tool's webhook
# or form endpoint). Server-only. Until it is set, the form says sign-ups open soon.
SIGNUP_WEBHOOK_URL=

# Public site URL, used for metadata and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
